# ============================================================================
# OVERRIDE — environment variables (backend)
# ----------------------------------------------------------------------------
# Copy this file to ".env" and fill in real values for any shared/production
# deployment:   cp .env.example .env
#
# LOCAL DEVELOPMENT NEEDS NONE OF THIS. application.properties ships with safe
# defaults, so the backend runs out of the box. These vars only OVERRIDE those
# defaults. Spring Boot maps each var onto a property (APP_JWT_SECRET ->
# app.jwt.secret). See setup.md section 3 for how to load them before running.
#
# .env is git-ignored — never commit real secrets.
# ============================================================================

# --- JWT (backend auth) ---
# Signing key for issued tokens. Use a random string of at least 32 chars (256 bits).
APP_JWT_SECRET=change-me-to-a-random-string-at-least-256-bits-long
# Token lifetime in milliseconds (default 24h = 86400000).
APP_JWT_EXPIRATION_MS=86400000

# --- MySQL (only if you switch the backend from H2 to MySQL for production) ---
# Quoted because the URL contains '&' (keeps shell `source` from breaking).
MYSQL_URL='jdbc:mysql://localhost:3306/override_db?useSSL=false&serverTimezone=UTC'
MYSQL_USER=root
# Your MySQL password for the override_db database.
MYSQL_PASSWORD=changeme
