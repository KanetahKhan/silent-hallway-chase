modules = ["java-graalvm22.3", "nodejs-24", "python-3.11"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Build Silent Classroom"

[[workflows.workflow]]
name = "Build Silent Classroom"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd java-game && ./gradlew :lwjgl3:jar 2>&1 && echo '✓ JAR built: java-game/lwjgl3/build/libs/silent-classroom.jar'"

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000
